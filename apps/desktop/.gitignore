# Generated by scripts/stage-runtime.mjs, which `bun run desktop:build` runs.
# The production payload is a build artifact, not source: a full copy of
# packages/cli/dist, its installed dependencies, and a bun binary.
runtime/

# Tauri's scaffolding uses a local frontend directory; the window loads
# http://127.0.0.1 instead, so nothing is ever built into it.
dist/
