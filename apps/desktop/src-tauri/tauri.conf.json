{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenVids",
  "version": "0.1.0",
  "identifier": "dev.openvids.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:serve",
    "devUrl": "http://127.0.0.1:5190",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": false,
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../runtime/bun": "bun",
      "../runtime/serve.mjs": "serve.mjs",
      "../runtime/hyperframes": "hyperframes",
      "../runtime/runtime.json": "runtime.json"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
