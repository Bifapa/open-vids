{
  "name": "@hyperframes/agent-runtime",
  "version": "0.8.81",
  "private": true,
  "description": "OpenVids Agent Runtime: a separate local Bun process that owns chats, turns, checkpoints and the OMP-backed Director. Never imported by the browser bundle or studio-server.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./main": {
      "bun": "./src/main.ts",
      "import": "./src/main.ts",
      "types": "./src/main.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "start": "bun src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.5",
    "@hyperframes/agent-protocol": "workspace:*",
    "@oh-my-pi/pi-ai": "18.8.3",
    "@oh-my-pi/pi-catalog": "18.8.3",
    "@oh-my-pi/pi-coding-agent": "18.8.3",
    "hono": "^4.0.0",
    "linkedom": "^0.18.12",
    "tldts": "^7.0.30"
  },
  "devDependencies": {
    "@hyperframes/studio-server": "workspace:*",
    "@types/node": "^25.0.10",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  }
}
