{
  "name": "@hyperframes/shader-transitions",
  "version": "0.8.81",
  "private": true,
  "description": "WebGL shader transitions for HyperFrames compositions",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
