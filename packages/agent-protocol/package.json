{
  "name": "@hyperframes/agent-protocol",
  "version": "0.8.81",
  "private": true,
  "description": "OpenVids-owned Agent Runtime protocol: chat/turn/message/event/editor-context schema shared by Studio, the studio-server gateway and the agent runtime. No runtime dependencies; browser-safe.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "node": "./dist/index.js",
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  }
}
